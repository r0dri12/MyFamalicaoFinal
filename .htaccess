Options -Indexes
RewriteEngine On
RewriteBase /MyFamalicaoFinal/

# 1. Remove .php extension internal rewrite
# If the request is not a real file or directory...
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
# ...try adding .php and serve it
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 2. Redirect .php to clean URL (Canonical)
# Only redirect GET requests to avoid losing POST data in forms
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,NE,L]

